---
import { langs, langNames, routes, type Lang, type PageKey, t } from '../i18n/routes';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const tr = t(lang);
---

<nav class="lang" aria-label={tr('nav.lang')}>
  {
    langs.map((l) => (
      <a
        href={routes[page][l]}
        hreflang={l}
        lang={l}
        class:list={['lang__item', { 'is-active': l === lang }]}
        aria-current={l === lang ? 'true' : undefined}
        title={langNames[l]}
      >
        {l.toUpperCase()}
      </a>
    ))
  }
</nav>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.35rem 0.6rem;
    gap: 0;
  }
  .lang__item {
    font-family: var(--font-head);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--muted);
    padding: 0.2rem 0.55rem;
    line-height: 1;
    border-left: 1px solid var(--line);
  }
  .lang__item:first-child {
    border-left: none;
  }
  .lang__item:hover {
    color: var(--ink);
  }
  .lang__item.is-active {
    color: var(--ink);
  }
</style>
