---
import { langs, langNames, routes, type Lang, type PageKey, t } from '../i18n/routes';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const tr = t(lang);
---

<nav class="lang" aria-label={tr('nav.lang')}>
  {
    langs.map((l) => (
      <a
        href={routes[page][l]}
        hreflang={l}
        lang={l}
        class:list={['lang__item', { 'is-active': l === lang }]}
        aria-current={l === lang ? 'true' : undefined}
        title={langNames[l]}
      >
        <span class="lang__flag" aria-hidden="true">
          {l === 'es' && (
            <svg viewBox="0 0 3 2" preserveAspectRatio="none">
              <rect width="3" height="2" fill="#AA151B" />
              <rect y="0.5" width="3" height="1" fill="#F1BF00" />
            </svg>
          )}
          {l === 'en' && (
            <svg viewBox="0 0 60 30" preserveAspectRatio="none">
              <rect width="60" height="30" fill="#012169" />
              <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
              <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="2.4" />
              <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10" />
              <path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6" />
            </svg>
          )}
          {l === 'fr' && (
            <svg viewBox="0 0 3 2" preserveAspectRatio="none">
              <rect width="1" height="2" fill="#002654" />
              <rect x="1" width="1" height="2" fill="#fff" />
              <rect x="2" width="1" height="2" fill="#CE1126" />
            </svg>
          )}
        </span>
        <span>{l.toUpperCase()}</span>
      </a>
    ))
  }
</nav>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.35rem 0.6rem;
    gap: 0;
  }
  .lang__item {
    font-family: var(--font-head);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--muted);
    padding: 0.2rem 0.55rem;
    line-height: 1;
    border-left: 1px solid var(--line);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lang__flag {
    display: inline-block;
    width: 18px;
    height: 12px;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(21, 21, 21, 0.12);
    opacity: 0.6;
    filter: saturate(0.6);
    transition: opacity 0.2s, filter 0.2s;
    flex-shrink: 0;
  }
  .lang__flag svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .lang__item:hover .lang__flag,
  .lang__item.is-active .lang__flag {
    opacity: 1;
    filter: none;
  }
  .lang__item:first-child {
    border-left: none;
  }
  .lang__item:hover {
    color: var(--ink);
  }
  .lang__item.is-active {
    color: var(--ink);
  }
</style>
