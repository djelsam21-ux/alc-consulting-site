---
/**
 * Logotipo Valteon (versión horizontal).
 * Monograma: doble chevrón en V (exterior dorado, interior en tinta)
 * + "VALTEON" en Plus Jakarta Sans 800 + "DIGITAL CONSULTING" en mono.
 */
interface Props {
  light?: boolean; // versión para fondos oscuros
  height?: number; // alto en px
  markOnly?: boolean; // solo el monograma
}
const { light = false, height = 44, markOnly = false } = Astro.props;
const ink = light ? '#faf8f3' : '#151515';
const gold = light ? '#c9a24a' : '#a9842f';
const sub = light ? 'rgba(250,248,243,0.72)' : '#656b73';
const viewBox = markOnly ? '0 0 120 120' : '0 0 520 120';
---

<span class="logo" style={`--logo-h:${height}px`}>
  <svg viewBox={viewBox} role="img" aria-label="Valteon">
    <path d="M14 22 L60 104 L106 22" fill="none" stroke={gold} stroke-width="11" stroke-linecap="square"></path>
    <path d="M40 22 L60 58 L80 22" fill="none" stroke={ink} stroke-width="7" stroke-linecap="square"></path>
    {
      !markOnly && (
        <>
          <text
            x="140"
            y="76"
            font-family="'Plus Jakarta Sans', Inter, system-ui, sans-serif"
            font-size="62"
            font-weight="800"
            fill={ink}
            textLength="372"
            lengthAdjust="spacing">
            VALTEON
          </text>
          <text
            x="142"
            y="106"
            font-family="'JetBrains Mono', ui-monospace, monospace"
            font-size="15"
            font-weight="500"
            fill={sub}
            textLength="368"
            lengthAdjust="spacing">
            DIGITAL CONSULTING
          </text>
        </>
      )
    }
  </svg>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
  }
  .logo svg {
    height: var(--logo-h, 44px);
    width: auto;
    overflow: visible;
  }
</style>
