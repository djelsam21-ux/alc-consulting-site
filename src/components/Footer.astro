---
import Logo from './Logo.astro';
import { siteConfig } from '../config';
import { path, type Lang, t } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo light height={40} />
      <p>{tr('footer.about')}</p>
      {
        siteConfig.linkedin && (
          <a class="footer__social" href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
            </svg>
            LinkedIn
          </a>
        )
      }
    </div>

    <div>
      <h4>{tr('footer.nav')}</h4>
      <ul>
        <li><a href={path('about', lang)} target="_blank" rel="noopener">{tr('nav.about')}</a></li>
        <li><a href={path('services', lang)}>{tr('nav.services')}</a></li>
        <li><a href={path('diagnostic', lang)}>{tr('nav.diagnostic')}</a></li>
        <li><a href={path('contact', lang)}>{tr('nav.contact')}</a></li>
      </ul>
    </div>

    <div>
      <h4>{tr('footer.contact')}</h4>
      <ul>
        <li><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></li>
        <li>{siteConfig.address}</li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>© {year} {siteConfig.name}. {tr('footer.rights')}</span>
    <span>
      <a href={path('legal', lang)}>{tr('footer.legal')}</a>
      ·
      <a href={path('privacy', lang)}>{tr('footer.privacy')}</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: rgba(255, 255, 255, 0.7);
    padding: 4rem 0 1.75rem;
    margin-top: auto;
  }
  .footer__grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1.6fr 1fr 1fr;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line-dark);
  }
  .footer__brand p {
    margin-top: 1.25rem;
    max-width: 400px;
    font-size: 0.93rem;
    line-height: 1.7;
  }
  .footer__social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .footer h4 {
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
    font-size: 0.93rem;
  }
  .footer a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--gold-light);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1.75rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
  }
  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
