    lead: 'Elige lo que prefieras: reserva directamente una llamada en nuestra agenda o cuéntanos tu caso por escrito y te respondemos en menos de un día laborable.',
    bookTitle: 'Reserva una llamada gratuita',
    bookText: '30 minutos, sin compromiso. Saldrás con al menos dos ideas accionables.',
    bookFallback: 'Si el calendario no carga, abre la agenda en una pestaña nueva:',
    bookOpen: 'Abrir agenda',
    formTitle: 'O escríbenos',
    formText: 'Cuanto más contexto nos des, más útil será nuestra primera respuesta.',
    name: 'Nombre y apellidos',
    company: 'Empresa',
    email: 'Email',
    phone: 'Teléfono (opcional)',
    service: '¿Qué te interesa?',
    serviceOther: 'No lo sé todavía / otra cosa',
    message: 'Cuéntanos tu situación',
    messagePh: 'Ej.: Somos 8 personas, facturamos con Excel y necesitamos cumplir con VeriFactu. También perdemos mucho tiempo con los presupuestos…',
    diagLabel: 'Resultado de tu diagnóstico (se adjunta automáticamente)',
    consent: 'He leído y acepto la',
    consentLink: 'política de privacidad',
    consentEnd: 'y el tratamiento de mis datos para responder a mi solicitud.',
    submit: 'Enviar mensaje',
    directTitle: 'Contacto directo',
    whatsapp: 'Escribir por WhatsApp',
    hours: 'Lunes a viernes, de 9:00 a 18:30 (hora peninsular)',
  },
  en: {
    metaTitle: 'Contact & book a call',
    metaDesc:
      'Request a quote or book a free 30-minute call with ALC Consulting. We serve SMEs across Spain in Spanish, English and French.',
    eyebrow: 'Contact',
    title: 'Let’s talk about ', accent: 'your business.',
    lead: 'Pick what suits you: book a call directly in our calendar, or tell us about your case in writing and we will reply within one working day.',
    bookTitle: 'Book a free call',
    bookText: '30 minutes, no strings attached. You will leave with at least two actionable ideas.',
    bookFallback: 'If the calendar does not load, open it in a new tab:',
    bookOpen: 'Open calendar',
    formTitle: 'Or write to us',
    formText: 'The more context you give us, the more useful our first reply will be.',
    name: 'Full name',
    company: 'Company',
    email: 'Email',
    phone: 'Phone (optional)',
    service: 'What are you interested in?',
    serviceOther: 'Not sure yet / something else',
    message: 'Tell us about your situation',
    messagePh: 'E.g.: We are a team of 8, we invoice with Excel and need to comply with VeriFactu. We also lose a lot of time on quotes…',
    diagLabel: 'Your assessment result (attached automatically)',
    consent: 'I have read and accept the',
    consentLink: 'privacy policy',
    consentEnd: 'and the processing of my data to answer my request.',
    submit: 'Send message',
    directTitle: 'Direct contact',
    whatsapp: 'Message on WhatsApp',
    hours: 'Monday to Friday, 9:00 to 18:30 (CET)',
  },
  fr: {
    metaTitle: 'Contact et réservation d’appel',
    metaDesc:
      'Demandez un devis ou réservez un appel gratuit de 30 minutes avec ALC Consulting. Nous accompagnons les PME de toute l’Espagne en espagnol, anglais et français.',
    eyebrow: 'Contact',
    title: 'Parlons de ', accent: 'votre entreprise.',
    lead: 'Choisissez ce qui vous convient : réservez directement un appel dans notre agenda, ou décrivez-nous votre cas par écrit et nous vous répondons sous un jour ouvré.',
    bookTitle: 'Réservez un appel gratuit',
    bookText: '30 minutes, sans engagement. Vous repartirez avec au moins deux idées concrètes.',
    bookFallback: 'Si le calendrier ne se charge pas, ouvrez l’agenda dans un nouvel onglet :',
    bookOpen: 'Ouvrir l’agenda',
    formTitle: 'Ou écrivez-nous',
    formText: 'Plus vous nous donnez de contexte, plus notre première réponse sera utile.',
    name: 'Nom et prénom',
    company: 'Entreprise',
    email: 'E-mail',
    phone: 'Téléphone (facultatif)',
    service: 'Qu’est-ce qui vous intéresse ?',
    serviceOther: 'Je ne sais pas encore / autre',
    message: 'Décrivez-nous votre situation',
    messagePh: 'Ex. : Nous sommes 8, nous facturons sous Excel et devons nous conformer à VeriFactu. Nous perdons aussi beaucoup de temps sur les devis…',
    diagLabel: 'Résultat de votre diagnostic (joint automatiquement)',
    consent: 'J’ai lu et j’accepte la',
    consentLink: 'politique de confidentialité',
    consentEnd: 'et le traitement de mes données pour répondre à ma demande.',
    submit: 'Envoyer le message',
