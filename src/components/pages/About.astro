---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Logo from '../Logo.astro';
import { services } from '../../data/services';
import { siteConfig } from '../../config';
import { path, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  es: {
    metaTitle: 'Quiénes somos',
    metaDesc:
      'Consultora de transformación digital con sede en Alicante: ayudamos a las PYMES de España a modernizar procesos, facturación y ventas con resultados medibles.',
    eyebrow: 'Quiénes somos',
    titleA: 'La consultora que convierte la tecnología en ',
    titleAccent: 'crecimiento real para las PYMES.',
    lead: 'Valteon acompaña a pequeñas y medianas empresas en España en cada etapa de su transformación digital: desde el diagnóstico hasta la implantación y la formación de sus equipos. Con la exigencia de una consultora internacional y la cercanía de un socio local.',
    ctaPrimary: 'Hablar con un consultor',
    ctaSecondary: 'Descubrir nuestros servicios',
    facts: [
      { value: 'Alicante', label: 'Sede central' },
      { value: 'España', label: 'Cobertura nacional, presencial y en remoto' },
      { value: 'ES · EN · FR', label: 'Equipo trilingüe' },
      { value: '7', label: 'Disciplinas bajo un mismo responsable' },
    ],
    storyEyebrow: 'Nuestra razón de ser',
    storyQuote: 'Las grandes empresas tienen departamentos enteros dedicados a la transformación digital. Las PYMES, que son el motor de la economía, merecen el mismo nivel de exigencia.',
    storyP1:
      'Valteon nació en Alicante de una constatación sencilla: la mayoría de las PYMES saben que deben digitalizarse, pero se enfrentan solas a un mercado lleno de herramientas, normativas cambiantes y promesas difíciles de evaluar. El resultado suele ser inversiones dispersas, equipos desbordados y sistemas que nadie utiliza de verdad.',
    storyP2:
      'Nuestra respuesta es un modelo de consultoría completo y accesible: un único interlocutor que entiende el negocio, diseña la hoja de ruta, implanta las soluciones y se queda hasta que funcionan. Aplicamos los métodos de las grandes consultoras (diagnóstico riguroso, gestión por fases, indicadores de resultado) a la escala y al presupuesto de una PYME.',
    pillarsEyebrow: 'Misión, visión, ambición',
    pillarsTitleA: 'Lo que nos mueve ',
    pillarsAccent: 'cada día.',
    pillars: [
      { icon: 'compass', title: 'Misión', text: 'Hacer que cada PYME acceda a una transformación digital de calidad, comprensible y rentable, que libere tiempo, reduzca riesgos y acelere su crecimiento.' },
      { icon: 'chart', title: 'Visión', text: 'Convertirnos en la referencia de la transformación digital de las PYMES en España, reconocida por la medida de sus resultados y no por la promesa de sus discursos.' },
      { icon: 'shield', title: 'Compromiso', text: 'Recomendaciones independientes, precios cerrados por fase y total transparencia sobre lo que funciona, lo que cuesta y lo que aporta cada decisión.' },
    ],
    doEyebrow: 'Lo que hacemos',
    doTitleA: 'Siete disciplinas, ',
    doAccent: 'una sola visión de tu empresa.',
    doLead: 'Intervenimos donde se juega el éxito de una PYME: su estrategia, su organización, su cumplimiento normativo, sus procesos, su presencia digital, su actividad comercial y las competencias de sus equipos.',
    doMore: 'Ver el detalle',
    approachEyebrow: 'Nuestro método',
    approachTitleA: 'Cuatro principios ',
    approachAccent: 'que no negociamos.',
    approach: [
      { title: 'Diagnóstico antes que propuesta', text: 'Nunca recomendamos una solución sin haber entendido antes cómo trabaja tu empresa. Cada proyecto empieza por un análisis de procesos, herramientas y datos.' },
      { title: 'Independencia total', text: 'No revendemos licencias ni tenemos acuerdos de exclusividad. Elegimos la herramienta que mejor se adapta a tu caso, aunque sea la más sencilla o la más económica.' },
      { title: 'Resultados medibles', text: 'Cada fase tiene un objetivo cuantificado (horas recuperadas, plazos de cobro, oportunidades cerradas) y termina con un informe de lo conseguido.' },
      { title: 'Transferencia de conocimiento', text: 'Formamos y documentamos para que tu equipo sea autónomo. Nuestro éxito se mide por lo que funciona cuando ya no estamos.' },
    ],
    sectorsEyebrow: 'Con quién trabajamos',
    sectorsTitleA: 'PYMES y autónomos ',
    sectorsAccent: 'de todos los sectores.',
    sectorsLead: 'Acompañamos a empresas de 1 a 50 personas que quieren profesionalizar su gestión y crecer con método.',
    sectors: ['Comercio y distribución', 'Construcción y reformas', 'Hostelería y turismo', 'Servicios profesionales', 'Logística y transporte', 'Salud y bienestar', 'Industria y talleres', 'Inmobiliaria'],
    intlEyebrow: 'Dimensión internacional',
    intlTitleA: 'Estándares europeos, ',
    intlAccent: 'atención en tu idioma.',
    intl: [
      { title: 'Equipo trilingüe', text: 'Trabajamos en español, inglés y francés: ideal para empresas extranjeras implantadas en España y para equipos internacionales.' },
      { title: 'Cumplimiento normativo', text: 'Dominamos el marco español y europeo: VeriFactu, factura electrónica, RGPD y buenas prácticas de seguridad.' },
      { title: 'Herramientas de nivel mundial', text: 'Seleccionamos e integramos las mejores soluciones del mercado internacional, adaptadas a la realidad de una PYME española.' },
    ],
    valuesEyebrow: 'Nuestros valores',
    values: [
      { title: 'Rigor', text: 'Excelencia en cada etapa.' },
      { title: 'Transparencia', text: 'Hablamos claro, siempre.' },
      { title: 'Cercanía', text: 'Un interlocutor que responde.' },
      { title: 'Impacto', text: 'Resultados, no promesas.' },
    ],
    finalTitle: 'Construyamos juntos la próxima etapa de tu empresa.',
    finalText: 'Una primera conversación de 30 minutos, gratuita y sin compromiso, para entender tus prioridades.',
    finalCta: 'Reservar una llamada',
    caption: 'Alicante · España',
  },
  en: {
    metaTitle: 'About us',
    metaDesc:
      'Digital transformation consultancy based in Alicante. We help SMEs across Spain modernise processes, invoicing and sales with measurable results.',
    eyebrow: 'About us',
    titleA: 'We help SMEs turn technology into ',
    titleAccent: 'real growth.',
    lead: 'Valteon guides small and medium-sized businesses in Spain through every stage of their digital transformation, from the first assessment to implementation and team training. The standards of an international consultancy, with the personal touch of a local partner.',
    ctaPrimary: 'Talk to a consultant',
    ctaSecondary: 'Discover our services',
    facts: [
      { value: 'Alicante', label: 'Head office' },
      { value: 'Spain', label: 'Nationwide, on site or remotely' },
      { value: 'ES · EN · FR', label: 'Trilingual team' },
      { value: '7', label: 'Areas of expertise, one point of contact' },
    ],
    storyEyebrow: 'Why we exist',
    storyQuote: 'Big corporations have whole departments devoted to digital transformation. SMEs, the backbone of the economy, deserve the same quality of support.',
    storyP1:
      'Valteon started in Alicante from a simple observation: most SMEs know they need to go digital, but they are left on their own to navigate a crowded tool market, changing regulations and promises that are hard to judge. The result is often money spent in the wrong places, overstretched teams and software nobody really uses.',
    storyP2:
      'Our answer is complete, affordable support: one point of contact who understands your business, draws up the roadmap, puts the solutions in place and stays until they work. We bring the methods of top consultancies (thorough assessment, step-by-step delivery, clear results) to the scale and budget of an SME.',
    pillarsEyebrow: 'Mission, vision, commitment',
    pillarsTitleA: 'What drives us ',
    pillarsAccent: 'every day.',
    pillars: [
      { icon: 'compass', title: 'Mission', text: 'To give every SME access to digital transformation that is high quality, easy to understand and worth the investment: freeing up time, reducing risk and driving growth.' },
      { icon: 'chart', title: 'Vision', text: 'To become the go-to partner for SME digital transformation in Spain, known for the results we deliver rather than the promises we make.' },
      { icon: 'shield', title: 'Commitment', text: 'Independent advice, a fixed price for each stage and complete openness about what works, what it costs and what each decision brings.' },
    ],
    doEyebrow: 'What we do',
    doTitleA: 'Seven areas of expertise, ',
    doAccent: 'one complete view of your business.',
    doLead: 'We focus on what makes or breaks an SME: strategy, organisation, compliance, processes, online presence, sales and the skills of its people.',
    doMore: 'See details',
    approachEyebrow: 'Our method',
    approachTitleA: 'Four principles ',
    approachAccent: 'we never compromise on.',
    approach: [
      { title: 'Assessment before proposal', text: 'We never recommend anything until we understand how your business works. Every project starts with a look at your processes, tools and data.' },
      { title: 'Full independence', text: 'We don’t resell licences and have no exclusive deals. We choose the tool that suits you best, even if it is the simplest or the cheapest.' },
      { title: 'Measurable results', text: 'Every stage has a clear, measurable target (hours saved, faster payments, deals won) and ends with a review of what was achieved.' },
      { title: 'Knowledge transfer', text: 'We train your team and document everything so you can manage on your own. We measure our success by what keeps working after we leave.' },
    ],
    sectorsEyebrow: 'Who we work with',
    sectorsTitleA: 'SMEs and freelancers ',
    sectorsAccent: 'in every sector.',
    sectorsLead: 'We work with businesses of 1 to 50 people that want to run things more professionally and grow in a structured way.',
    sectors: ['Retail & distribution', 'Construction & renovation', 'Hospitality & tourism', 'Professional services', 'Logistics & transport', 'Health & wellbeing', 'Industry & workshops', 'Real estate'],
    intlEyebrow: 'International reach',
    intlTitleA: 'European standards, ',
    intlAccent: 'support in your language.',
    intl: [
      { title: 'Trilingual team', text: 'We work in Spanish, English and French, which makes us a natural fit for foreign companies based in Spain and for international teams.' },
      { title: 'Regulatory compliance', text: 'We know the Spanish and European rules inside out: VeriFactu, e-invoicing, GDPR and security best practice.' },
      { title: 'Best-in-class tools', text: 'We choose and connect the best solutions on the market, adapted to how a Spanish SME really works.' },
    ],
    valuesEyebrow: 'Our values',
    values: [
      { title: 'Rigour', text: 'High standards at every step.' },
      { title: 'Transparency', text: 'We always speak plainly.' },
      { title: 'Approachability', text: 'Someone who actually picks up.' },
      { title: 'Impact', text: 'Results, not promises.' },
    ],
    finalTitle: 'Let’s build the next chapter of your business together.',
    finalText: 'A free, no-obligation 30-minute call to understand your priorities.',
    finalCta: 'Book a call',
    caption: 'Alicante · Spain',
  },
  fr: {
    metaTitle: 'Qui sommes-nous ?',
    metaDesc:
      'Cabinet de transformation digitale basé à Alicante : nous aidons les PME en Espagne à moderniser processus, facturation et ventes, avec des résultats mesurables.',
    eyebrow: 'Qui sommes-nous ?',
    titleA: 'Nous aidons les PME à transformer la technologie en ',
    titleAccent: 'croissance réelle.',
    lead: 'Valteon accompagne les petites et moyennes entreprises en Espagne à chaque étape de leur transformation digitale, du premier diagnostic jusqu’à la mise en place et à la formation des équipes. L’exigence d’un cabinet international, la proximité d’un partenaire local.',
    ctaPrimary: 'Parler à un consultant',
    ctaSecondary: 'Découvrir nos services',
    facts: [
      { value: 'Alicante', label: 'Siège social' },
      { value: 'Espagne', label: 'Partout en Espagne, sur place ou à distance' },
      { value: 'ES · EN · FR', label: 'Équipe trilingue' },
      { value: '7', label: 'Expertises, un seul interlocuteur' },
    ],
    storyEyebrow: 'Notre raison d’être',
    storyQuote: 'Les grands groupes ont des services entiers dédiés à la transformation digitale. Les PME, qui font tourner l’économie, méritent le même niveau d’accompagnement.',
    storyP1:
      'Valteon est née à Alicante d’un constat simple : la plupart des PME savent qu’elles doivent se digitaliser, mais elles se retrouvent seules face à une multitude d’outils, à des règles qui changent sans cesse et à des promesses difficiles à vérifier. Résultat : de l’argent dépensé au mauvais endroit, des équipes débordées et des logiciels que personne n’utilise vraiment.',
    storyP2:
      'Notre réponse : un accompagnement complet et abordable, avec un interlocuteur unique qui comprend votre métier, construit la feuille de route, met en place les solutions et reste jusqu’à ce qu’elles fonctionnent. Nous appliquons les méthodes des grands cabinets (diagnostic rigoureux, avancement par étapes, résultats mesurés) à l’échelle et au budget d’une PME.',
    pillarsEyebrow: 'Mission, vision, engagement',
    pillarsTitleA: 'Ce qui nous anime ',
    pillarsAccent: 'chaque jour.',
    pillars: [
      { icon: 'compass', title: 'Mission', text: 'Donner à chaque PME accès à une transformation digitale de qualité, claire et rentable, qui libère du temps, réduit les risques et accélère la croissance.' },
      { icon: 'chart', title: 'Vision', text: 'Devenir la référence de la transformation digitale des PME en Espagne, reconnue pour ses résultats plutôt que pour ses promesses.' },
      { icon: 'shield', title: 'Engagement', text: 'Des conseils indépendants, un prix fixe pour chaque étape et une transparence totale sur ce qui marche, ce que cela coûte et ce que chaque décision rapporte.' },
    ],
    doEyebrow: 'Ce que nous faisons',
    doTitleA: 'Sept expertises, ',
    doAccent: 'une vision d’ensemble de votre entreprise.',
    doLead: 'Nous intervenons là où se joue la réussite d’une PME : sa stratégie, son organisation, sa conformité, ses processus, sa présence en ligne, ses ventes et les compétences de ses équipes.',
    doMore: 'Voir le détail',
    approachEyebrow: 'Notre méthode',
    approachTitleA: 'Quatre principes ',
    approachAccent: 'non négociables.',
    approach: [
      { title: 'Le diagnostic avant la proposition', text: 'Nous ne recommandons rien avant d’avoir compris comment fonctionne votre entreprise. Chaque projet commence par l’analyse de vos processus, de vos outils et de vos données.' },
      { title: 'Une indépendance totale', text: 'Nous ne revendons pas de licences et n’avons aucun accord d’exclusivité. Nous choisissons l’outil le mieux adapté à votre cas, même s’il est le plus simple ou le moins cher.' },
      { title: 'Des résultats mesurables', text: 'Chaque étape a un objectif chiffré (heures gagnées, délais de paiement, contrats signés) et se termine par un bilan des résultats obtenus.' },
      { title: 'Le transfert de compétences', text: 'Nous formons vos équipes et documentons tout pour qu’elles deviennent autonomes. Notre réussite se mesure à ce qui continue de fonctionner une fois que nous sommes partis.' },
    ],
    sectorsEyebrow: 'Avec qui nous travaillons',
    sectorsTitleA: 'PME et indépendants ',
    sectorsAccent: 'de tous les secteurs.',
    sectorsLead: 'Nous accompagnons des entreprises de 1 à 50 personnes qui veulent structurer leur gestion et se développer avec méthode.',
    sectors: ['Commerce et distribution', 'Bâtiment et rénovation', 'Hôtellerie et tourisme', 'Services professionnels', 'Logistique et transport', 'Santé et bien-être', 'Industrie et ateliers', 'Immobilier'],
    intlEyebrow: 'Ouverture internationale',
    intlTitleA: 'Des standards européens, ',
    intlAccent: 'un accompagnement dans votre langue.',
    intl: [
      { title: 'Équipe trilingue', text: 'Nous travaillons en espagnol, en anglais et en français : un vrai atout pour les entreprises étrangères implantées en Espagne et les équipes internationales.' },
      { title: 'Conformité réglementaire', text: 'Nous connaissons parfaitement les règles espagnoles et européennes : VeriFactu, facture électronique, RGPD et bonnes pratiques de sécurité.' },
      { title: 'Les meilleurs outils du marché', text: 'Nous choisissons et connectons les meilleures solutions disponibles, adaptées au quotidien d’une PME espagnole.' },
    ],
    valuesEyebrow: 'Nos valeurs',
    values: [
      { title: 'Rigueur', text: 'L’excellence à chaque étape.' },
      { title: 'Transparence', text: 'Nous parlons vrai, toujours.' },
      { title: 'Proximité', text: 'Un interlocuteur qui répond vraiment.' },
      { title: 'Impact', text: 'Des résultats, pas des promesses.' },
    ],
    finalTitle: 'Construisons ensemble la prochaine étape de votre entreprise.',
    finalText: 'Un premier échange de 30 minutes, gratuit et sans engagement, pour faire le point sur vos priorités.',
    finalCta: 'Réserver un appel',
    caption: 'Alicante · Espagne',
  },
} as const;

const c = copy[lang];
const contactUrl = path('contact', lang);
const servicesUrl = path('services', lang);
const pad = (n: number) => String(n + 1).padStart(2, '0');

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: c.metaTitle,
  description: c.metaDesc,
  mainEntity: {
    '@type': 'Organization',
    name: siteConfig.name,
    email: siteConfig.email,
    address: { '@type': 'PostalAddress', streetAddress: 'Avenida Maisonave, 28 BIS, 4º', postalCode: '03003', addressLocality: 'Alicante', addressCountry: 'ES' },
    knowsLanguage: ['es', 'en', 'fr'],
    areaServed: 'ES',
  },
};
---

<Base lang={lang} page="about" title={c.metaTitle} description={c.metaDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <!-- HERO -->
  <section class="page-head about-hero">
    <div class="container about-hero__inner">
      <div>
        <span class="eyebrow eyebrow--line">{c.eyebrow}</span>
        <h1>{c.titleA}<span class="accent">{c.titleAccent}</span></h1>
        <p class="lead">{c.lead}</p>
        <div class="btn-row">
          <a href={`${contactUrl}#reservar`} class="btn btn--primary btn--lg">{c.ctaPrimary}</a>
          <a href={servicesUrl} class="btn btn--outline-light btn--lg btn--noarrow">{c.ctaSecondary}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FACTS -->
  <section class="facts">
    <div class="container">
      <ul class="facts__list">
        {
          c.facts.map((f) => (
            <li>
              <strong>{f.value}</strong>
              <span>{f.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- STORY -->
  <section class="section">
    <div class="container story">
      <div class="story__visual">
        <div class="story__card">
          <Logo markOnly height={150} />
          <span class="story__badge">{c.caption}</span>
        </div>
      </div>
      <div>
        <span class="eyebrow">{c.storyEyebrow}</span>
        <blockquote class="story__quote">{c.storyQuote}</blockquote>
        <p class="lead">{c.storyP1}</p>
        <p class="lead">{c.storyP2}</p>
      </div>
    </div>
  </section>

  <!-- MISSION / VISION / COMMITMENT -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{c.pillarsEyebrow}</span>
        <h2>{c.pillarsTitleA}<span class="accent">{c.pillarsAccent}</span></h2>
      </div>
      <div class="grid grid--3">
        {
          c.pillars.map((p, i) => (
            <div class:list={['card', 'card--hover', 'pillar', { 'card--gold': i === 1 }]}>
              <div class="icon-badge">
                <Icon name={p.icon} />
              </div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">{c.doEyebrow}</span>
          <h2>{c.doTitleA}<span class="accent">{c.doAccent}</span></h2>
        </div>
        <p class="lead">{c.doLead}</p>
      </div>
      <ol class="disc">
        {
          services.map((s, i) => (
            <li class="disc__item">
              <span class="num">{pad(i)}</span>
              <div class="disc__main">
                <h3>{s.title[lang]}</h3>
                <p>{s.short[lang]}</p>
              </div>
              <a href={`${servicesUrl}#${s.id}`} class="link-caps disc__link">
                {c.doMore} →
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- APPROACH (dark) -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{c.approachEyebrow}</span>
        <h2>{c.approachTitleA}<span class="accent">{c.approachAccent}</span></h2>
      </div>
      <div class="approach">
        {
          c.approach.map((a, i) => (
            <div class="card card--dark approach__item">
              <span class="approach__n">{pad(i)}</span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SECTORS -->
  <section class="section">
    <div class="container sectors">
      <div>
        <span class="eyebrow">{c.sectorsEyebrow}</span>
        <h2>{c.sectorsTitleA}<span class="accent">{c.sectorsAccent}</span></h2>
        <p class="lead">{c.sectorsLead}</p>
      </div>
      <ul class="sectors__list">
        {c.sectors.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <!-- INTERNATIONAL -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{c.intlEyebrow}</span>
        <h2>{c.intlTitleA}<span class="accent">{c.intlAccent}</span></h2>
      </div>
      <div class="grid grid--3">
        {
          c.intl.map((x) => (
            <div class="card card--hover intl">
              <h3>{x.title}</h3>
              <p>{x.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">{c.valuesEyebrow}</span>
      <ul class="values">
        {
          c.values.map((v) => (
            <li>
              <strong>{v.title}</strong>
              <span>{v.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FINAL -->
  <section class="section section--tight">
    <div class="container">
      <div class="final">
        <div>
          <h2>{c.finalTitle}</h2>
          <p class="mono">{c.finalText}</p>
        </div>
        <a href={`${contactUrl}#reservar`} class="btn btn--light btn--lg">{c.finalCta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .about-hero {
    padding: clamp(3rem, 7vw, 6rem) 0;
    background:
      radial-gradient(700px 420px at 90% 0%, rgba(184, 146, 61, 0.28), transparent 60%),
      linear-gradient(180deg, var(--dark) 0%, var(--dark-2) 100%);
  }
  .about-hero h1 {
    max-width: 18ch;
    font-size: clamp(2.5rem, 5.4vw, 4.4rem);
  }
  .about-hero .lead {
    max-width: 680px;
    margin-bottom: 2rem;
  }

  /* Facts */
  .facts {
    border-bottom: 1px solid var(--line);
  }
  .facts__list {
    list-style: none;
    margin: 0;
    padding: 2.5rem 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .facts__list li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--gold);
  }
  .facts__list strong {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
