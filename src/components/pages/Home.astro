<style>
  /* Hero */
  .hero {
    padding: clamp(1.75rem, 3.5vw, 2.75rem) 0 clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .hero h1 {
    max-width: 13ch;
  }
  .hero .lead {
    max-width: 520px;
    margin-bottom: 2rem;
  }
  .hero__note {
    margin: 1.75rem 0 0;
  }
  .hero__visual {
    justify-self: end;
    width: 100%;
    max-width: 560px;
  }

  /* Stats */
  .stats {
    border-bottom: 1px solid var(--line);
  }
  .stats__list {
    list-style: none;
    margin: 0;
    padding: 2.5rem 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .stats__list li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .stats__list strong {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(2rem, 3vw, 2.6rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }
  .stats__list small {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gold);
    margin-left: 0.3rem;
    letter-spacing: 0;
  }
  .stats__list span {
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* Why */
  .why {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .why > div:first-child {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .cascade {
    margin: 0.25rem 0 0;
    font-size: clamp(2.6rem, 5.2vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .cascade__line {
    display: block;
    padding-left: calc(var(--i) * 0.45em);
    white-space: nowrap;
  }
  .cascade__line.accent {
    color: var(--gold);
  }
  .cascade__line + .cascade__line {
    margin-top: 0.06em;
  }
  .cascade__line:last-child::after {
    content: '';
    display: block;
    width: 3.2rem;
    height: 3px;
    margin-top: 0.45em;
    margin-left: 0.05em;
    border-radius: 3px;
    background: var(--gold);
  }
  .why__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .why__item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    color: var(--ink-2);
    font-size: 0.97rem;
  }
  .why__dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    margin-top: 0.55rem;
  }

  /* Services grid */
  .svc-all {
    justify-self: end;
  }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .svc {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    padding: 2rem;
  }
  .svc h3 {
    font-size: 1.15rem;
  }
  .svc p {
    margin: 0 0 1.25rem;
    font-size: 0.93rem;
    color: var(--ink-2);
    flex: 1;
  }
  .svc.card--gold p {
    color: rgba(255, 255, 255, 0.85);
  }
  .svc__deliv {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-dark);
  }
  .svc.card--gold .svc__deliv {
    color: rgba(255, 255, 255, 0.75);
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .about__card {
    position: relative;
    aspect-ratio: 1665 / 1328;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(600px 400px at 80% 0%, rgba(184, 146, 61, 0.35), transparent 60%),
      linear-gradient(160deg, #1f1f1f, #0f0f0f);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .about__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .about__card:hover .about__photo {
    transform: scale(1.03);
  }
  .about__badge {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 500;
    backdrop-filter: blur(8px);
  }
  .about .lead {
    font-size: 1rem;
  }
  .about .checks {
    margin-top: 1.5rem;
  }

  /* Pains */
  .pain h3 {
    font-size: 1.1rem;
  }
  .pain p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--ink-2);
  }

  /* Table */
  .table-wrap {
    overflow-x: auto;
  }
  .table {
    min-width: 680px;
  }

  /* Process */
  .process {
    padding: 0;
    overflow: hidden;
  }
  .process__row {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
    gap: 2rem;
    padding: 1.75rem 2rem;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .process__head h3 {
    font-size: 1.1rem;
    margin: 0.4rem 0 0;
  }
  .process__text {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .process__out {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    font-size: 0.93rem;
  }
  .process__out .mono {
    color: var(--gold);
  }
  .process__cta {
    display: flex;
    justify-content: center;
    padding: 1.5rem 2rem;
    background: var(--surface);
  }

  /* Diagnostic */
  .diag {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 3rem;
    align-items: center;
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid var(--line);
    border-left: 4px solid var(--gold);
    border-radius: var(--radius-lg);
    background: #fff;
  }
  .diag h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
  }
  .diag .lead {
    margin: 0;
    font-size: 1rem;
  }
  .diag__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    justify-self: end;
  }

  /* Ways */
  .way {
    display: flex;
    flex-direction: column;
  }
  .way__tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }
  .way h3 {
    font-size: 1.15rem;
  }
  .way p {
    color: var(--ink-2);
    font-size: 0.93rem;
    flex: 1;
  }

  /* FAQ */
  .faq-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 3rem;
    align-items: start;
  }
  .faq-wrap h2 {
    max-width: 14ch;
  }
  .faq {
    display: grid;
    gap: 0.75rem;
  }
  .faq__item {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 0 1.4rem;
    background: #fff;
  }
  .faq__item summary {
    cursor: pointer;
    padding: 1.15rem 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    color: var(--gold);
    font-size: 1.3rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .faq__item[open] summary::after {
    content: '−';
  }
  .faq__item p {
    margin: 0 0 1.3rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  /* Final banner */
  .final {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem);
    background: linear-gradient(135deg, var(--dark) 0%, var(--dark-3) 100%);
    border-radius: var(--radius-lg);
    color: #fff;
  }
  .final h2 {
    color: #fff;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin-bottom: 0.5rem;
  }
  .final .mono {
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
  }

  @media (max-width: 1000px) {
    .svc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .process__row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
