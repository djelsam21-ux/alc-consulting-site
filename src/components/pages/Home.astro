        <span class="eyebrow">{c.heroEyebrow}</span>
        <h1>{c.heroA}<span class="accent">{c.heroAccent}</span></h1>
        <p class="lead">{c.heroLead}</p>
        <div class="btn-row">
          <a href={servicesUrl} class="btn btn--dark btn--lg">{c.heroCta2}</a>
          <a href={`${contactUrl}#reservar`} class="btn btn--ghost btn--lg btn--noarrow">{c.heroCta}</a>
        </div>
        <p class="hero__note mono">{c.heroNote}</p>
      </div>
      <div class="hero__visual">
        <HeroVisual labels={c.visual} />
      </div>
    </div>
  </section>

  <div class="screen screen--group">
  <!-- STATS -->
  <section class="stats">
    <div class="container">
      <ul class="stats__list">
        {
          c.stats.map((s) => (
            <li>
              <strong>
                {s.value}
                {s.unit && <small>{s.unit}</small>}
              </strong>
              <span>{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...c.marquee, ...c.marquee].map((w) => <span class="marquee__item">{w}</span>)}
    </div>
  </div>

  <!-- WHY -->
  <section class="section section--why">
    <div class="container why">
      <div>
        <span class="eyebrow">{c.whyEyebrow}</span>
        <h2 class="cascade" aria-label={c.whyTitle}>
          {
            c.whyLines.map((line, i) => (
              <span class:list={['cascade__line', { accent: i === c.whyLines.length - 1 }]} style={`--i:${i}`}>
                {line}
              </span>
            ))
          }
        </h2>
      </div>
      <ul class="why__list">
        {
          c.why.map((w) => (
            <li class="why__item">
              <span class="why__dot"></span>
              <span>{w}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  </div>

  <!-- WHAT WE DO (dark) -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">{c.servicesEyebrow}</span>
          <h2>{c.servicesTitle}</h2>
        </div>
      </div>
      <div class="svc-grid">
        {
          services.map((s, i) => (
            <a href={`${servicesUrl}#${s.id}`} class:list={['svc', 'flip', 'card', 'card--hover', s.id === 'facturacion' ? 'card--gold' : 'card--soft', { 'svc--wide': s.id === 'creacion' }]}>
              <div class="flip__front" aria-hidden="true">
                <div class="icon-badge">
                  <Icon name={s.icon} />
                </div>
                <span class="flip__plus"></span>
                <p class="flip__title">{s.title[lang]}</p>
              </div>
              <div class="flip__back">
                <h3>{s.title[lang]}</h3>
                <div class="flip__inner">
                  <p>{s.short[lang]}</p>
                  <span class="svc__deliv">{s.deliverables[lang].join(' · ')}</span>
                </div>
              </div>
            </a>
          ))
        }
        <a href={servicesUrl} class="svc-more">
          <span class="svc-more__label">{c.allServices}</span>
          <span class="svc-more__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section section--alt">
    <div class="container about">
      <div class="about__visual">
        <div class="about__card">
          <img class="about__photo" src="/equipo.jpg" alt={c.aboutPhotoAlt} width="1665" height="1328" loading="lazy" decoding="async" />
        </div>
      </div>
      <div>
        <span class="eyebrow">{c.aboutEyebrow}</span>
        <h2>{c.aboutTitleA}<span class="accent">{c.aboutAccent}</span></h2>
        <ul class="strengths" data-cycle>
          {
            c.strengths.map((x, i) => (
              <li class:list={['strength', { 'is-active': i === 0 }]} data-cycle-item>
                <span class="strength__n">{pad(i)}</span>
                <span class="strength__k">{x.k}</span>
                <span class="strength__s">{x.s}</span>
                <i class="strength__bar"></i>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- PAINS (cards) -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{c.painsEyebrow}</span>
        <h2>{c.painsTitleA}<span class="accent">{c.painsAccent}</span></h2>
      </div>
      <div class="grid grid--4">
        {
          c.pains.map((p) => (
            <div class="card card--hover pain flip" tabindex="0">
              <div class="flip__front" aria-hidden="true">
                <div class="icon-badge">
                  <Icon name={p.icon} />
                </div>
                <span class="flip__plus"></span>
                <p class="flip__title">{p.title}</p>
              </div>
              <div class="flip__back">
                <h3>{p.title}</h3>
                <div class="flip__inner">
                  <p>{p.text}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{c.compEyebrow}</span>
        <h2>{c.compTitleA}<span class="accent">{c.compAccent}</span></h2>
      </div>
      <div class="ba" data-ba data-stage="0">
        <div class="ba__tabs" role="tablist">
          {
            c.baStages.map((st, i) => (
              <button type="button" role="tab" class:list={['ba__tab', { 'is-active': i === 0 }]} data-stage-btn={i} aria-selected={i === 0 ? 'true' : 'false'}>
                <span class="ba__tab-n">{pad(i)}</span>
                {st}
                <i class="ba__progress"></i>
              </button>
            ))
          }
        </div>
        <div class="ba__grid">
          {
            c.comp.map((row, i) => (
              <div class="ba__card" style={`--i:${i}`}>
                <div class="ba__top">
                  <span class="ba__idx">{pad(i)}</span>
                  <span class="ba__cap">
                    {c.baCaptions.map((cap, s) => (
                      <span class={`ba__layer ba__layer--${s}`}>{cap}</span>
                    ))}
                  </span>
                </div>
                <div class="ba__stack">
                  {row.map((txt, s) => (
                    <p class={`ba__layer ba__txt ba__layer--${s}`}>{txt}</p>
                  ))}
                </div>
                <span class="ba__icon" aria-hidden="true">
                  <span class="ba__layer ba__layer--0">…</span>
                  <span class="ba__layer ba__layer--1">✓</span>
                  <span class="ba__layer ba__layer--2">↗</span>
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS (numbered table) -->
  <section id="metodo" class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{c.processEyebrow}</span>
        <h2>{c.processTitleA}<span class="accent">{c.processAccent}</span></h2>
      </div>
      <div class="steps" data-steps data-step="0">
        <div class="steps__nav-wrap">
          <div class="steps__track" aria-hidden="true"><i class="steps__fill"></i></div>
          <ol class="steps__nav" role="tablist">
            {
              c.process.map((step, i) => (
                <li>
                  <button type="button" role="tab" class:list={['steps__btn', { 'is-active': i === 0 }]} data-step-btn={i} aria-selected={i === 0 ? 'true' : 'false'}>
                    <span class="steps__dot">{pad(i)}</span>
                    <span class="steps__title">{step.title}</span>
                  </button>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="steps__panel">
          <div class="steps__stack">
            {
              c.process.map((step, i) => (
                <div class={`steps__pane steps__layer--${i}`}>
                  <div class="steps__main">
                    <span class="steps__kicker">{pad(i)} · {step.title}</span>
                    <p class="steps__text">{step.text}</p>
                  </div>
                  <div class="steps__out">
                    <span class="steps__out-label">{c.stepOutLabel}</span>
                    <strong>{step.out}</strong>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="steps__cta">
            <a href={`${contactUrl}#reservar`} class="btn btn--primary">{c.processCta}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DIAGNOSTIC -->
  <section class="section">
    <div class="container">
      <div class="diag">
        <div class="diag__text">
          <span class="eyebrow eyebrow--line">{c.diagEyebrow}</span>
          <h2>{c.diagTitleA}<span class="accent">{c.diagAccent}</span></h2>
          <p class="lead">{c.diagText}</p>
        </div>
        <div class="diag__cta">
          <a href={diagnosticUrl} class="btn btn--primary btn--lg">{c.diagCta}</a>
          <span class="mono">{c.diagNote}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- THREE WAYS -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{c.waysEyebrow}</span>
        <h2>{c.waysTitle}</h2>
      </div>
      <div class="grid grid--3">
        {
          c.ways.map((w) => (
            <div class="card card--hover way flip" tabindex="0">
              <div class="flip__front" aria-hidden="true">
                <span class="way__tag">{w.tag}</span>
                <span class="flip__plus"></span>
                <p class="flip__title">{w.title}</p>
              </div>
              <div class="flip__back">
                <h3>{w.title}</h3>
                <div class="flip__inner">
                  <p>{w.text}</p>
                  <a href={contactUrl} class="link-caps">{w.link} →</a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-wrap">
      <div>
        <span class="eyebrow">{c.faqEyebrow}</span>
        <h2>{c.faqTitle}</h2>
      </div>
      <div class="faq">
        {
          c.faq.map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FINAL CTA BANNER -->
  <section class="section section--tight">
    <div class="container">
      <div class="final">
        <div>
          <h2>{c.finalTitle}</h2>
          <p class="mono">{c.finalText}</p>
        </div>
        <a href={`${contactUrl}#reservar`} class="btn btn--light btn--lg">{c.finalCta}</a>
      </div>
    </div>
  </section>
  </div>
</Base>

