---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';
import { langs, locales, routes, type Lang, type PageKey, t } from '../i18n/routes';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  noindex?: boolean;
}

const { lang, page, title, description, noindex = false } = Astro.props;
const tr = t(lang);
const site = Astro.site ?? new URL('https://alc-consulting.netlify.app');
const canonical = new URL(routes[page][lang], site).href;
const fullTitle = page === 'home' ? `${siteConfig.name} — ${title}` : `${title} · ${siteConfig.name}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteConfig.name,
  description: siteConfig.tagline[lang],
  url: site.href,
  email: siteConfig.email,
  telephone: siteConfig.phone,
  areaServed: 'ES',
  address: { '@type': 'PostalAddress', addressLocality: 'Alicante', addressCountry: 'ES' },
  sameAs: siteConfig.linkedin ? [siteConfig.linkedin] : [],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      langs.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(routes[page][l], site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(routes[page].es, site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1b1e21" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locales[lang].replace('-', '_')} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{tr('skip')}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
